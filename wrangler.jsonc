{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peak-country-hail",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *", "*/10 * * * *", "17 8 * * *"]
  }
  // After creating D1, add the binding returned by Wrangler, for example:
  // ,"d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "peak-country-hail-db",
  //     "database_id": "REPLACE_WITH_REAL_UUID"
  //   }
  // ]
}
