---
import { site } from '../data/site';
import {canonicalPath, canonicalUrl, isProductionHostname, robotsMeta} from '../lib/seo';
import { pageGraph } from '../lib/schema';
import SiteHeader from '../components/SiteHeader.astro';
import StormHeader from '../components/StormHeader.astro';
import '../styles/global.css';
import '../styles/hail-workspace.css';
interface Props { title: string; description: string; noindex?: boolean; exactTitle?: boolean; pageSchema?: Record<string, unknown>; }
const { title, description, noindex = false, exactTitle = false, pageSchema } = Astro.props;
const pathname = canonicalPath(Astro.url.pathname);
const canonical = canonicalUrl(pathname);
const robots = robotsMeta(Astro.url.hostname, noindex);
const preview = !isProductionHostname(Astro.url.hostname);
const documentTitle = exactTitle ? title : `${title} | Peak Country`;
const graph = pageGraph(pathname, title, description, pageSchema);
const socialImage = new URL(site.socialImage.src, site.url).href;
const breadcrumbNames: Record<string, string> = { 'hail-tracker': 'Hail Tracker', greeley: 'Greeley', 'weld-county': 'Weld County', 'northern-colorado': 'Northern Colorado', 'case-studies': 'Repair Gallery', locations: 'Service Area' };
const breadcrumbSegments = pathname.split('/').filter(Boolean);
const breadcrumbItems = breadcrumbSegments.map((segment, index) => ({
  label: index === breadcrumbSegments.length - 1 ? title.split('|')[0].trim() : (breadcrumbNames[segment] ?? segment.replace(/-/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase())),
  href: `/${breadcrumbSegments.slice(0, index + 1).join('/')}/`,
}));
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
<title>{documentTitle}</title><meta name="description" content={description} />
<link rel="canonical" href={canonical} /><meta name="robots" content={robots} />
<meta property="og:title" content={documentTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:type" content="website" /><meta property="og:site_name" content={site.name} /><meta property="og:locale" content="en_US" />
<meta property="og:image" content={socialImage} /><meta property="og:image:secure_url" content={socialImage} /><meta property="og:image:type" content={site.socialImage.type} /><meta property="og:image:width" content={String(site.socialImage.width)} /><meta property="og:image:height" content={String(site.socialImage.height)} /><meta property="og:image:alt" content={site.socialImage.alt} />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={documentTitle} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} /><meta name="twitter:image:alt" content={site.socialImage.alt} />
<meta name="author" content={site.name} />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="alternate" type="application/rss+xml" title="Peak Country Hail and Repair Resources" href={`${site.url}/feed.xml`} />
<meta name="theme-color" content="#102536" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
</head><body>
<a class="skip" href="#main">Skip to content</a>
{preview && <div class="preview">Preview · Business details and online requests are being prepared</div>}
{pathname === '/' ? <StormHeader /> : <SiteHeader />}
<main id="main">
{breadcrumbItems.length > 0 && <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li>{breadcrumbItems.map((item, index) => <li>{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.label}</span> : <a href={item.href}>{item.label}</a>}</li>)}</ol></nav>}
<slot /></main>
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <strong>{site.name}</strong>
      <p>{site.focus}</p>
      <p>Mobile paintless dent repair service · By appointment</p>
      {site.phone && <p><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a> · Call or text</p>}
      {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
    </div>
    <nav class="site-footer__nav" aria-label="Footer navigation">
      <div><strong>Repair</strong><a href="/auto-hail-repair/">Hail Repair</a><a href="/paintless-dent-repair/">PDR</a><a href="/gallery/">Gallery</a><a href="/repair-standards/">Repair Standards</a><a href="/warranty/">Workmanship Warranty</a></div>
      <div><strong>Plan</strong><a href="/get-started/">Get Started</a><a href="/service-area/">Service Area</a><a href="/estimating-documentation/">Estimating &amp; Documentation</a><a href="/faq/#insurance-questions">Insurance FAQ</a><a href="/contact/">Contact</a></div>
      <div><strong>Learn</strong><a href="/hail-tracker/">Hail Tracker</a><a href="/about/">About</a><a href="/resources/">Resources</a><a href="/data-sources/">Weather Data Sources</a><a href="/feed.xml">Resource Feed</a></div>
    </nav>
    <div class="site-footer__legal"><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></div>
    <p class="fine">Weather reports describe reported conditions, not confirmed damage to an individual vehicle. For urgent weather information, follow the National Weather Service and local emergency officials.</p>
  </div>
</footer>
</body></html>
