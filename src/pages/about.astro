---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

const title = 'About Peak Country PDR | Greeley Auto Hail Repair';
const description = 'Meet the technician behind Peak Country. 20+ years of paintless dent repair experience serving Greeley, Weld County and Northern Colorado.';
const faq = [
  ['How much paintless dent repair experience does Peak Country have?', `Peak Country is built around ${site.experience.toLowerCase()} repairing hail damage, door dings, creases and other repairable dents.`],
  ['What types of dents can Peak Country repair?', 'Peak Country specializes in auto hail damage, door dings, minor dents and creases that are good candidates for paintless dent repair. Each vehicle is evaluated individually because not every dent is appropriate for PDR.'],
  ['Can hail damage be repaired without repainting a vehicle?', 'In many cases, yes. Paintless dent repair reshapes damaged metal while preserving the original factory paint when the paint and panel are suitable for PDR.'],
  ['Does Peak Country work with insurance hail claims?', 'Yes. Peak Country works with insurance hail damage claims as well as customer-pay paintless dent repairs.'],
  ['What areas does Peak Country serve?', 'Peak Country is a mobile service serving Greeley and surrounding Northern Colorado communities including Evans, Windsor, Eaton, Severance, Johnstown, Milliken, LaSalle and Platteville, with a primary service focus on Weld County.'],
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${site.url}/about/#faq`,
  mainEntity: faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
};
const pageSchema = site.ownerName ? {
  '@context': 'https://schema.org',
  '@graph': [faqSchema, {
    '@type': 'Person',
    '@id': `${site.url}/about/#owner`,
    name: site.ownerName,
    jobTitle: 'Owner / Paintless Dent Repair Technician',
    worksFor: { '@id': `${site.url}/#business` },
    knowsAbout: ['Auto Hail Repair', 'Paintless Dent Repair', 'Door Ding Repair', 'Crease Repair'],
    ...(site.ownerPhoto ? { image: new URL(site.ownerPhoto, site.url).href } : {})
  }]
} : faqSchema;
---
<Layout title={title} description={description} exactTitle pageSchema={pageSchema}>
  <div class="page-head about-head">
    <div class="eyebrow">The technician behind Peak Country</div>
    <h1>About Peak Country Auto Hail Repair &amp; Paintless Dent Repair</h1>
    <p>{site.experience}, careful workmanship and straight answers for vehicle owners in Northern Colorado.</p>
    <div class="about-actions">
      <a class="button" href="/free-hail-inspection/">Request a Free Hail Inspection</a>
      <a class="text-link" href="/paintless-dent-repair/">See Our Paintless Dent Repair Services</a>
    </div>
  </div>

  <section class="section about-intro" aria-labelledby="experience-heading">
    <div>
      <div class="eyebrow">Experience at the center of every repair</div>
      <h2 id="experience-heading">20+ Years of Hands-On Paintless Dent Repair Experience</h2>
      <p class="lead">{site.experience} is the foundation of Peak Country Auto Hail Repair &amp; Paintless Dent Repair.</p>
      <p>Peak Country specializes in <a href="/auto-hail-repair/">auto hail damage repair</a>, <a href="/paintless-dent-repair/">paintless dent repair (PDR)</a>, door dings, creases and minor dents for vehicle owners in Greeley, Weld County and throughout Northern Colorado.</p>
      <p>The owner/technician built Peak Country around a simple idea: do the repair correctly, take care of the vehicle and give the customer straight answers.</p>
    </div>
    <aside class="technician-card" aria-label="Peak Country technician profile">
      {site.ownerPhoto ? <img class="technician-photo technician-photo--real" src={site.ownerPhoto} alt={`${site.ownerName ?? 'Peak Country owner'} performing paintless dent repair`} /> : <div class="technician-photo technician-photo--prepared" role="img" aria-label="Decorative paintless dent repair reflection-line graphic"><span aria-hidden="true">PDR</span></div>}
      <div class="technician-details">
        <span class="profile-label">Technician-led service</span>
        <h3>Owner / Paintless Dent Repair Technician</h3>
        <dl>
          <div><dt>Experience</dt><dd>20+ Years of Hands-On PDR Experience</dd></div>
          <div><dt>Location</dt><dd>Greeley / Northern Colorado</dd></div>
          <div><dt>Service</dt><dd>Mobile, by appointment</dd></div>
          <div><dt>Specialties</dt><dd>Auto Hail Repair · Paintless Dent Repair · Door Dings · Creases</dd></div>
        </dl>
      </div>
    </aside>
  </section>

  <section class="about-dark">
    <div class="section about-split">
      <div>
        <div class="eyebrow">Workmanship over sales tactics</div>
        <h2>A Different Approach to Auto Hail Repair</h2>
      </div>
      <div class="about-copy">
        <p>Hail repair has become a highly competitive business, and customers are often approached with promotions, giveaways and aggressive sales pitches after a major Colorado hailstorm.</p>
        <p><strong>Peak Country is built around the repair itself.</strong></p>
        <p>The focus is the experience behind the work, the quality of the workmanship, and the way the vehicle is handled during the repair.</p>
        <p>When paintless dent repair is appropriate, the goal is to restore the damaged metal while preserving the vehicle’s original factory paint. PDR can often repair hail damage and dents without sanding, body filler or repainting.</p>
        <p>If a dent is not a good candidate for paintless dent repair, Peak Country explains the limitation instead of promising a result that PDR is not suited to produce.</p>
      </div>
    </div>
  </section>

  <section class="section about-principles" aria-label="Peak Country repair principles">
    <article class="principle-card">
      <span class="principle-number">01</span>
      <h2>The Entire Vehicle Matters</h2>
      <p>Good paintless dent repair involves more than simply making a dent disappear. Accessing hail damage can require the careful removal of trim, interior panels, headliners, lights or other vehicle components. Those parts need to be handled properly and reinstalled correctly when the repair is complete.</p>
      <p>Attention stays on the entire vehicle throughout that process, not only the damaged panel. That includes careful handling of the components needed for access and a methodical reassembly and review.</p>
      <p><a href="/repair-standards/">Read the Peak Country PDR repair standards</a> for the inspection, access, protection and final-review principles behind this approach.</p>
    </article>
    <article class="principle-card">
      <span class="principle-number">02</span>
      <h2>Clear Communication and Realistic Expectations</h2>
      <p>You should understand what is being repaired, how it will be repaired and what to expect before leaving your vehicle with someone.</p>
      <p>Peak Country provides straightforward estimates and realistic recommendations about what paintless dent repair can accomplish. I also believe in communicating with customers during the repair rather than leaving them wondering what is happening with their vehicle.</p>
      <p><strong>No confusing sales pitch. No unnecessary promises. Just clear information about the repair.</strong></p>
    </article>
  </section>

  <section class="service-region">
    <div class="section service-region-grid">
      <div>
        <div class="eyebrow">Mobile service across the region</div>
        <h2>Auto Hail Repair and PDR in Northern Colorado</h2>
        <p>Colorado hailstorms can cause anything from a few isolated dents to extensive damage across the hood, roof, fenders, doors, quarter panels and trunk or liftgate.</p>
        <p>Peak Country is a mobile paintless dent repair service serving Greeley, Evans, Windsor, Eaton, Severance, Johnstown, Milliken, LaSalle, Platteville and surrounding communities throughout Weld County and Northern Colorado.</p>
        <p><a href="/service-area/">Explore the Peak Country service area</a> or check the <a href="/hail-tracker/">Northern Colorado Hail Tracker</a> for current official-source weather information.</p>
      </div>
      <div class="service-list">
        <h3>Professional PDR for</h3>
        <ul>
          <li>Auto hail damage</li>
          <li>Paintless dent repair (PDR)</li>
          <li>Door dings</li>
          <li>Minor dents</li>
          <li>Creases</li>
          <li>Insurance hail damage claims</li>
          <li>Customer-pay dent repairs</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section experience-close">
    <div class="experience-mark" aria-hidden="true">20<span>+</span></div>
    <div>
      <div class="eyebrow">A skilled trade refined over time</div>
      <h2>Experience Matters</h2>
      <p>Paintless dent repair is a skilled trade. The tools matter, but knowing how metal moves, understanding proper access and recognizing when a dent can—or cannot—be repaired with PDR comes from experience.</p>
      <p>{site.experience} informs each repairability decision and repair plan at Peak Country.</p>
      <p>If your vehicle has hail damage, a door ding, crease or unwanted dent, contact Peak Country Auto Hail Repair &amp; Paintless Dent Repair for a free evaluation and find out whether PDR is the right repair for your vehicle.</p>
    </div>
  </section>

  <section class="section narrow prose" aria-labelledby="editorial-standards-heading">
    <div class="eyebrow">Authorship and source standards</div>
    <h2 id="editorial-standards-heading">Who reviews Peak Country’s repair and hail information?</h2>
    <p><strong>Peak Country’s owner/technician reviews repair information using more than 20 years of hands-on PDR experience.</strong> No public personal name is published until the owner approves one. Repair guidance explains general considerations and does not replace a direct vehicle inspection.</p>
    <p>Hail information identifies its government source, timestamp, geographic scope, preliminary status when applicable, and limitations. National Weather Service, Storm Prediction Center, and NOAA/NCEI records are kept distinct, and the site does not treat a nearby report as proof of damage to a particular vehicle.</p>
    <p class="content-review">Last reviewed September 8, 2026 · Reviewed by Peak Country Auto Hail Repair &amp; Paintless Dent Repair</p>
  </section>

  <section class="about-faq" aria-labelledby="faq-heading">
    <div class="section">
      <div class="section-head">
        <div><div class="eyebrow">Straight answers</div><h2 id="faq-heading">About Peak Country PDR</h2></div>
        <a href="/faq/">View all frequently asked questions</a>
      </div>
      <div class="faq-list">
        {faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </div>
  </section>

  <section class="about-cta" aria-labelledby="about-cta-heading">
    <div>
      <div class="eyebrow">Mobile service · Greeley and Northern Colorado</div>
      <h2 id="about-cta-heading">Let’s take a careful look at the damage.</h2>
      <p>Call or text <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>, or send the vehicle details online to begin.</p>
      <div class="about-actions">
        <a class="button" href="/free-hail-inspection/">Request a Free Hail Inspection</a>
        <a class="text-link" href="/paintless-dent-repair/">See Our Paintless Dent Repair Services</a>
      </div>
    </div>
  </section>
</Layout>
