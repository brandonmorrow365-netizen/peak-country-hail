---
import Layout from '../layouts/Layout.astro';
import {pages} from '../data/pages';
const page=pages.find(p=>p.slug===Astro.params.slug);
if(!page)return Astro.rewrite('/404');
const relatedBySlug:Record<string,{href:string;label:string}[]>={
  'hail-damage-guide':[{href:'/hail-tracker/',label:'Check current hail reports'},{href:'/hail-size-guide/',label:'Understand hail sizes'},{href:'/auto-hail-repair/',label:'Explore auto hail repair'},{href:'/repair-standards/',label:'Review repairability standards'},{href:'/free-hail-inspection/',label:'Start with a Free Initial Assessment'}],
  'insurance-claims':[{href:'/estimating-documentation/',label:'Estimating and documentation'},{href:'/faq/#insurance-questions',label:'Insurance repair questions'},{href:'/auto-hail-repair/',label:'Auto hail repair'},{href:'/repair-standards/',label:'Repair standards'},{href:'/get-started/',label:'Get Started'}],
  'why-pdr':[{href:'/paintless-dent-repair/',label:'How PDR works'},{href:'/repair-standards/',label:'How repairability is evaluated'},{href:'/gallery/',label:'View real repair examples'},{href:'/door-ding-repair/',label:'Door ding repair'},{href:'/get-started/',label:'Get Started'}],
};
const related=relatedBySlug[page.slug]??[{href:'/hail-tracker/',label:'Regional hail tracker'},{href:'/free-hail-inspection/',label:'Request an assessment'},{href:'/process/',label:'Repair process'}];
---
<Layout title={page.title} description={page.description} noindex={page.noindex}><div class="page-head"><div class="eyebrow">Peak Country · Northern Colorado</div><h1>{page.title}</h1><p>{page.description}</p></div><section class="section narrow"><div class="prose">{page.sections.map(([heading,body])=><section><h2>{heading}</h2><p>{body}</p></section>)}</div>
{['data-sources','resources','hail-size-guide','after-a-hailstorm'].includes(page.slug)&&<div class="links"><a href="https://www.weather.gov/">National Weather Service</a><a href="https://www.spc.noaa.gov/climo/reports/">SPC reports</a><a href="https://www.ncei.noaa.gov/stormevents/">NOAA/NCEI Storm Events</a></div>}
<nav class="links" aria-label="Related information">{related.map(link=><a href={link.href}>{link.label}</a>)}{page.slug==='process'&&<a href="/repair-standards/">Peak Country repair standards</a>}</nav></section></Layout>
