---
import Layout from '../../layouts/Layout.astro';
import {site} from '../../data/site';
import reportsJson from '../../../data/hail-history/hail-reports-2016-2025.json';
import manifest from '../../../data/hail-history/source-manifest.json';
import {MONTHS,PUBLIC_HISTORY_END_YEAR,PUBLIC_HISTORY_RANGE,PUBLIC_HISTORY_START_YEAR,PUBLIC_HISTORY_YEARS,publicHistory,reportDate,subsetSummary,type HistoricalHailReport} from '../../lib/hailHistory';
const reports=publicHistory(reportsJson as HistoricalHailReport[]).toSorted((a,b)=>b.year-a.year||String(b.begin_date_time).localeCompare(String(a.begin_date_time)));
const summary=subsetSummary(reports);
const years=PUBLIC_HISTORY_YEARS.map(year=>[String(year),subsetSummary(reports.filter(report=>report.year===year))] as const);
const locations=summary.locations.map(([location])=>location);
const mostActiveMonthCount=reports.filter(report=>report.month_name===summary.most_active_month).length;
const title=`Greeley & Northern Colorado Hail History ${PUBLIC_HISTORY_RANGE}`;
const description=`Search ${summary.report_count.toLocaleString()} verified NOAA/NCEI hail reports across ${summary.hail_day_count} hail days within 50 miles of Greeley for the current five-calendar-year window, ${PUBLIC_HISTORY_RANGE}.`;
const schema={'@context':'https://schema.org','@type':'Dataset','@id':`${site.url}/northern-colorado-hail-history/#dataset`,name:`Northern Colorado NOAA Hail Reports Within 50 Miles of Greeley, ${PUBLIC_HISTORY_RANGE}`,description,url:`${site.url}/northern-colorado-hail-history/`,mainEntityOfPage:{'@id':`${site.url}/northern-colorado-hail-history/#webpage`},datePublished:'2026-09-05',dateModified:manifest.generated_at,temporalCoverage:`${PUBLIC_HISTORY_START_YEAR}-01-01/${PUBLIC_HISTORY_END_YEAR}-12-31`,spatialCoverage:{'@type':'Place',name:'Area within 50 statute miles of the Greeley, Colorado geographic anchor',geo:{'@type':'GeoCoordinates',latitude:manifest.geographic_filter.latitude,longitude:manifest.geographic_filter.longitude}},creator:{'@type':'Organization',name:'NOAA National Centers for Environmental Information',url:manifest.canonical_source.base_url},publisher:{'@id':`${site.url}/#business`},isBasedOn:manifest.archives.filter(archive=>archive.year>=PUBLIC_HISTORY_START_YEAR).map(archive=>archive.url),measurementTechnique:manifest.geographic_filter.method,variableMeasured:['Hail report count','Hail day count','Reported hail magnitude','Distance from Greeley geographic anchor']};
const mapData=reports.map(r=>({lat:r.begin_lat,lon:r.begin_lon,date:reportDate(r),time:r.begin_date_time,location:r.begin_location,area:r.cz_name,size:r.magnitude,distance:r.distance_from_greeley_miles,source:r.source,url:r.noaa_event_url,id:r.event_id,year:r.year,month:r.month_name}));
---
<Layout title={title} description={description} exactTitle pageSchema={schema}>
  <header class="page-head history-head hail-workspace"><div class="eyebrow">Verified NOAA/NCEI Storm Events data</div><h1>Five Years of Reported Hail Near Greeley, Colorado</h1><p>Qualifying official observations within 50 statute miles of the Greeley geographic anchor for the current five-calendar-year window, {PUBLIC_HISTORY_RANGE}. NOAA/NCEI completed records currently cover 2022–2025; 2026 remains provisional and is kept in the live tracker.</p><div class="about-actions"><a class="button" href="#history-records">Explore Verified Reports →</a><a class="text-link" href="/hail-tracker/">View the Live Hail Tracker →</a></div></header>

  <section class="section history-definitions"><article><span>Hail report</span><p>One qualifying official NOAA observation. Multiple reports can occur during the same weather episode.</p></article><article><span>Hail day</span><p>One calendar date with at least one qualifying report, regardless of how many observations occurred that day.</p></article><article><span>Storm or episode</span><p>Used only when NOAA source identifiers support grouping observations. Report count is not storm count.</p></article></section>

  <section class="section history-summary" aria-labelledby="window-summary"><div class="section-head"><div><div class="eyebrow">{PUBLIC_HISTORY_RANGE} Public Window</div><h2 id="window-summary">Verified five-year summary</h2></div><p>Calculated only from qualifying NOAA/NCEI records in the public five-calendar-year window. The current provisional year remains separate.</p></div><div class="history-stat-grid"><article><span>Total Hail Reports</span><strong>{summary.report_count.toLocaleString()}</strong></article><article><span>Total Hail Days</span><strong>{summary.hail_day_count}</strong></article><article><span>Largest Reported Hail</span><strong>{summary.largest_reported_hail_inches?.toFixed(2)??'—'} in.</strong></article><article><span>Reports ≥ 1 Inch</span><strong>{summary.hail_report_count_1in_plus.toLocaleString()}</strong></article><article><span>Reports ≥ 2 Inches</span><strong>{summary.hail_report_count_2in_plus.toLocaleString()}</strong></article><article><span>Closest Observation</span><strong>{summary.closest_report_distance?.toFixed(1)??'—'} mi.</strong></article><article><span>Most Active Month</span><strong>{summary.most_active_month??'—'}</strong></article></div></section>

  <section class="section history-years history-topo" aria-labelledby="year-heading"><div class="section-head"><div><div class="eyebrow">Year Selector</div><h2 id="year-heading">Annual hail-report context</h2></div><p>Counts describe reports and hail days, not a number of separate storms. The 2026 live season remains preliminary until NOAA/NCEI publishes completed records.</p></div><div class="year-card-grid">{years.map(([year,value])=><details><summary><strong>{year}</strong><span>{value.report_count} reports · {value.hail_day_count} hail days</span></summary>{value.report_count?<dl><div><dt>Largest reported hail</dt><dd>{value.largest_reported_hail_inches?.toFixed(2)??'Not supplied'} in.</dd></div><div><dt>Reports ≥ 1 inch</dt><dd>{value.hail_report_count_1in_plus}</dd></div><div><dt>Reports ≥ 2 inches</dt><dd>{value.hail_report_count_2in_plus}</dd></div><div><dt>Most active month</dt><dd>{value.most_active_month}</dd></div><div><dt>Closest report</dt><dd>{value.closest_report_distance?.toFixed(1)??'—'} mi.</dd></div><div><dt>Locations represented</dt><dd>{value.locations.length}</dd></div></dl>:<p>Current-year reports remain preliminary in the live tracker. No completed NOAA/NCEI archive records are included here yet.</p>}</details>)}</div></section>

  <section class="section history-map-section" aria-labelledby="map-heading"><div class="section-head"><div><div class="eyebrow">Coordinate Plot</div><h2 id="map-heading">Verified report locations</h2></div><p>The plot and table share the same active filters. This is a coordinate view, not a parcel-level hail footprint or proof of vehicle damage.</p></div><div class="history-map-legend" aria-label="Plot legend"><span><i class="plot-dot plot-dot--small"></i>Below 1 inch or magnitude not supplied</span><span><i class="plot-dot plot-dot--medium"></i>1–1.99 inches</span><span><i class="plot-dot plot-dot--large"></i>2 inches or larger</span></div><div class="history-map" data-history-map><canvas role="img" aria-label="Filtered plot of verified NOAA hail-report coordinates within 50 miles of Greeley"></canvas><p class="map-status">Plot ready to load when visible.</p><div class="map-detail" aria-live="polite"><strong>Select a plotted point for official report details.</strong></div></div><script is:inline id="history-map-data" type="application/json" set:html={JSON.stringify(mapData).replace(/</g,'\\u003c')} /></section>

  <section class="section history-records" id="history-records" aria-labelledby="records-heading"><div class="section-head"><div><div class="eyebrow">Accessible Historical Archive</div><h2 id="records-heading">Verified reports in the five-year window</h2></div><p><span data-result-count>{reports.length.toLocaleString()}</span> matching reports</p></div><form class="history-filters" data-history-filters><label>Year<select name="year"><option value="">All years</option>{years.map(([year])=><option value={year}>{year}</option>)}</select></label><label>Month<select name="month"><option value="">All months</option>{MONTHS.map(month=><option value={month}>{month}</option>)}</select></label><label>Hail size<select name="size"><option value="">All reported sizes</option><option value="1">At least 1 inch</option><option value="2">At least 2 inches</option><option value="missing">Magnitude not supplied</option></select></label><label>Distance<select name="distance"><option value="50">Within 50 miles</option><option value="25">Within 25 miles</option><option value="10">Within 10 miles</option><option value="5">Within 5 miles</option></select></label><label>Location/community<input name="location" type="search" list="history-locations" placeholder="Example: Greeley"/><datalist id="history-locations">{locations.map(location=><option value={location}/>)}</datalist></label><button type="reset">Reset filters</button></form><p class="table-scroll-hint">Swipe or scroll horizontally to see all report columns →</p><div class="table-wrap history-table" tabindex="0" aria-label="Scrollable table of verified NOAA hail reports"><table><caption>NOAA/NCEI Hail observations in the {PUBLIC_HISTORY_RANGE} public window within 50 statute miles of the Greeley geographic anchor. Current-year preliminary activity is available in the live tracker.</caption><thead><tr><th>Date and time</th><th>Location</th><th>County/zone</th><th>Reported size</th><th>Distance</th><th>Report source</th></tr></thead><tbody>{reports.map(r=><tr data-history-row data-year={r.year} data-month={r.month_name} data-size={r.magnitude??''} data-distance={r.distance_from_greeley_miles} data-location={`${r.begin_location??''} ${r.cz_name??''}`.toLowerCase()}><td>{r.begin_date_time??'Not supplied'}</td><td>{r.begin_location??'Not supplied'}</td><td>{r.cz_name??'Not supplied'}</td><td>{r.magnitude===null?'Not supplied':`${r.magnitude.toFixed(2)} in.`}</td><td>{r.distance_from_greeley_miles.toFixed(1)} mi.</td><td>{r.source??'Not supplied'}<br/><a href={r.noaa_event_url}>NOAA event {r.event_id}</a></td></tr>)}</tbody></table></div></section>

  <section class="section history-answers history-topo"><div><div class="eyebrow">Verified Answers</div><h2>What the current five-year window shows</h2></div><div><h3>How often has hail been reported near Greeley?</h3><p>NOAA/NCEI recorded <strong>{summary.report_count.toLocaleString()} qualifying hail reports across {summary.hail_day_count} hail days</strong> within 50 miles of the Greeley anchor in the {PUBLIC_HISTORY_RANGE} public window. Reports are observations, not a count of separate storms.</p><h3>Which months produced the most reports?</h3><p><strong>{summary.most_active_month}</strong> produced the most qualifying reports, with {mostActiveMonthCount.toLocaleString()} observations in the verified dataset.</p><h3>What was the largest reported hail?</h3><p>The largest supplied NOAA magnitude was <strong>{summary.largest_reported_hail_inches?.toFixed(2)} inches</strong> within the defined radius during the displayed period.</p><h3>Does a NOAA report prove vehicle damage?</h3><p>No. It confirms an official observation was recorded at a time and coordinate. It does not prove a particular vehicle was exposed or damaged; a direct inspection is required.</p></div></section>

  <section class="section history-method"><div><div class="eyebrow">Source &amp; Methodology</div><h2>NOAA/NCEI Storm Events Database</h2></div><div><dl><div><dt>Radius</dt><dd>50 statute miles from the Greeley geographic anchor</dd></div><div><dt>Public window</dt><dd>{PUBLIC_HISTORY_RANGE}</dd></div><div><dt>Completed records</dt><dd>2022–2025</dd></div><div><dt>Current season</dt><dd>2026 is provisional/current and remains separate in the live tracker</dd></div><div><dt>Calculation</dt><dd>{manifest.geographic_filter.method}</dd></div><div><dt>Last generated</dt><dd>{new Date(manifest.generated_at).toLocaleString('en-US',{timeZone:'America/Denver',dateStyle:'medium',timeStyle:'short'})} MT</dd></div></dl><p>NOAA may correct or revise Storm Events archives. Peak Country filters and presents the underlying observations but did not create them. The master source archive is retained; only records in the public five-calendar-year window are sent to this page.</p><a href="/data-sources/">Read the weather data methodology →</a></div></section>
  <nav class="section history-links" aria-label="Related hail and repair resources"><a href="/hail-tracker/">Live Hail Tracker →</a><a href="/hail-tracker/greeley/">Greeley Hail Tracker →</a><a href="/hail-tracker/weld-county/">Weld County Hail Tracker →</a><a href="/hail-tracker/northern-colorado/">Northern Colorado Tracker →</a><a href="/hail-size-guide/">Hail Size Guide →</a><a href="/after-a-hailstorm/">After a Hailstorm →</a><a href="/auto-hail-repair/">Auto Hail Repair →</a><a href="/paintless-dent-repair/">Paintless Dent Repair →</a><a href="/service-area/">Service Area →</a><a href="/repair-standards/">Repair Standards →</a><a href="/free-hail-inspection/">Free Initial Assessment →</a></nav>
  <div class="hail-mountain-transition" aria-hidden="true"></div>
</Layout>

<script>
  const form=document.querySelector<HTMLFormElement>('[data-history-filters]'),rows=[...document.querySelectorAll<HTMLTableRowElement>('[data-history-row]')],count=document.querySelector<HTMLElement>('[data-result-count]');
  function applyFilters(){if(!form)return;const data=new FormData(form),year=String(data.get('year')||''),month=String(data.get('month')||''),size=String(data.get('size')||''),distance=Number(data.get('distance')||50),location=String(data.get('location')||'').trim().toLowerCase();let visible=0;for(const row of rows){const magnitude=row.dataset.size===''?null:Number(row.dataset.size),show=(!year||row.dataset.year===year)&&(!month||row.dataset.month===month)&&(!location||row.dataset.location?.includes(location))&&Number(row.dataset.distance)<=distance&&(!size||(size==='missing'?magnitude===null:magnitude!==null&&magnitude>=Number(size)));row.hidden=!show;if(show)visible++;}if(count)count.textContent=visible.toLocaleString();document.dispatchEvent(new CustomEvent('history-filter',{detail:{year,month,size,distance,location}}));}
  form?.addEventListener('input',applyFilters);form?.addEventListener('reset',()=>setTimeout(applyFilters));
  const host=document.querySelector<HTMLElement>('[data-history-map]'),canvas=host?.querySelector('canvas'),status=host?.querySelector<HTMLElement>('.map-status'),detail=host?.querySelector<HTMLElement>('.map-detail'),raw=document.querySelector<HTMLScriptElement>('#history-map-data')?.textContent;let allPoints:any[]=[],points:any[]=[],drawn:any[]=[];
  function draw(){if(!canvas||!host)return;const ratio=Math.min(devicePixelRatio||1,2),width=host.clientWidth,height=Math.max(330,Math.min(560,width*.55)),ctx=canvas.getContext('2d'),mobile=width<600;canvas.width=width*ratio;canvas.height=height*ratio;canvas.style.height=`${height}px`;ctx?.setTransform(ratio,0,0,ratio,0,0);if(!ctx)return;ctx.fillStyle='#07192d';ctx.fillRect(0,0,width,height);ctx.strokeStyle='#3377a544';for(let i=1;i<5;i++){ctx.beginPath();ctx.arc(width/2,height/2,(Math.min(width,height)*.46/4)*i,0,Math.PI*2);ctx.stroke()}drawn=points.map(point=>{const x=20+(point.lon+106.1)/(2.45)*(width-40),y=20+(41.2-point.lat)/(2.45)*(height-40);ctx.fillStyle=point.size>=2?'#f2b84b':point.size>=1?'#5cbcff':'#d9e8f5';ctx.beginPath();ctx.arc(x,y,point.size>=2?(mobile?5:3.3):(mobile?3.2:2.1),0,Math.PI*2);ctx.fill();return{...point,x,y};});if(status)status.textContent=`${points.length.toLocaleString()} verified coordinates plotted. Select a point for details.`;}
  function loadMap(){if(!raw)return;allPoints=JSON.parse(raw);points=allPoints;draw();form?.dispatchEvent(new Event('input'));new ResizeObserver(draw).observe(host!);canvas?.addEventListener('click',event=>{const rect=canvas.getBoundingClientRect(),x=event.clientX-rect.left,y=event.clientY-rect.top,nearest=drawn.map(point=>({...point,d:Math.hypot(point.x-x,point.y-y)})).sort((a,b)=>a.d-b.d)[0];if(!nearest||nearest.d>14||!detail)return;detail.replaceChildren();const heading=document.createElement('strong');heading.textContent=`${nearest.date} · ${nearest.location||'Location not supplied'}`;const text=document.createElement('p');text.textContent=`${nearest.area||'Area not supplied'} · ${nearest.size===null?'Magnitude not supplied':nearest.size.toFixed(2)+' in.'} · ${nearest.distance.toFixed(1)} miles from Greeley · ${nearest.source||'Source not supplied'}`;const link=document.createElement('a');link.href=nearest.url;link.textContent=`Official NOAA event ${nearest.id} →`;detail.appendChild(heading);detail.appendChild(text);detail.appendChild(link);});}
  document.addEventListener('history-filter',(event)=>{if(!allPoints.length)return;const {year,month,size,distance,location}=(event as CustomEvent).detail;points=allPoints.filter(point=>{const magnitude=point.size===null?null:Number(point.size);return(!year||String(point.year)===year)&&(!month||point.month===month)&&(!location||`${point.location??''} ${point.area??''}`.toLowerCase().includes(location))&&Number(point.distance)<=distance&&(!size||(size==='missing'?magnitude===null:magnitude!==null&&magnitude>=Number(size)));});draw();});
  if(host)new IntersectionObserver(([entry],observer)=>{if(entry.isIntersecting){loadMap();observer.disconnect();}},{rootMargin:'150px'}).observe(host);
</script>
