---
import Layout from '../../layouts/Layout.astro';
import {site} from '../../data/site';
import reportsJson from '../../../data/hail-history/hail-reports-2016-2025.json';
import summary from '../../../data/hail-history/hail-history-summary.json';
import manifest from '../../../data/hail-history/source-manifest.json';
import {MONTHS,reportDate,type HistoricalHailReport} from '../../lib/hailHistory';
const reports=(reportsJson as HistoricalHailReport[]).toSorted((a,b)=>b.year-a.year||String(b.begin_date_time).localeCompare(String(a.begin_date_time)));
const years=Object.entries(summary.annual).toSorted(([a],[b])=>Number(b)-Number(a));
const locations=Object.keys(summary.overall.reports_by_location_or_community);
const mostActiveMonthCount=(summary.overall.reports_by_month as Record<string,number>)[summary.overall.most_active_month];
const title='Greeley & Northern Colorado Hail History 2016–2025';
const description=`Search ${summary.overall.report_count.toLocaleString()} verified NOAA/NCEI hail reports across ${summary.overall.hail_day_count} hail days within 50 miles of Greeley, with annual statistics for 2016–2025.`;
const schema={'@context':'https://schema.org','@graph':[{'@type':'WebPage','@id':`${site.url}/northern-colorado-hail-history/#page`,name:title,description,url:`${site.url}/northern-colorado-hail-history/`,breadcrumb:{'@id':`${site.url}/northern-colorado-hail-history/#breadcrumbs`}},{'@type':'BreadcrumbList','@id':`${site.url}/northern-colorado-hail-history/#breadcrumbs`,itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:site.url+'/'},{'@type':'ListItem',position:2,name:'Northern Colorado Hail History',item:`${site.url}/northern-colorado-hail-history/`}]},{'@type':'Dataset','@id':`${site.url}/northern-colorado-hail-history/#dataset`,name:'Northern Colorado NOAA Hail Reports Within 50 Miles of Greeley, 2016–2025',description,temporalCoverage:'2016-01-01/2025-12-31',spatialCoverage:{'@type':'Place',name:'Area within 50 statute miles of the Greeley, Colorado geographic anchor',geo:{'@type':'GeoCoordinates',latitude:manifest.geographic_filter.latitude,longitude:manifest.geographic_filter.longitude}},creator:{'@type':'Organization',name:'NOAA National Centers for Environmental Information',url:manifest.canonical_source.base_url},publisher:{'@id':`${site.url}/#business`},isBasedOn:manifest.archives.map(archive=>archive.url),measurementTechnique:manifest.geographic_filter.method,variableMeasured:['Hail report count','Hail day count','Reported hail magnitude','Distance from Greeley geographic anchor']}]};
const mapData=reports.map(r=>({lat:r.begin_lat,lon:r.begin_lon,date:reportDate(r),time:r.begin_date_time,location:r.begin_location,area:r.cz_name,size:r.magnitude,distance:r.distance_from_greeley_miles,source:r.source,url:r.noaa_event_url,id:r.event_id,year:r.year,month:r.month_name}));
---
<Layout title={title} description={description} exactTitle pageSchema={schema}>
  <header class="page-head history-head"><div class="eyebrow">Verified NOAA/NCEI Storm Events data</div><h1>10 Years of Reported Hail Near Greeley, Colorado</h1><p>Qualifying official observations within 50 statute miles of the Greeley geographic anchor during the ten completed seasons from 2016 through 2025. The current 2026 season is provisional and excluded from these completed-decade statistics.</p><div class="about-actions"><a class="button" href="#history-records">Explore Verified Reports →</a><a class="text-link" href="/hail-tracker/">View the Live Hail Tracker →</a></div></header>

  <section class="section history-definitions"><article><span>Hail report</span><p>One qualifying official NOAA observation. Multiple reports can occur during the same weather episode.</p></article><article><span>Hail day</span><p>One calendar date with at least one qualifying report, regardless of how many observations occurred that day.</p></article><article><span>Storm or episode</span><p>Used only when NOAA source identifiers support grouping observations. Report count is not storm count.</p></article></section>

  <section class="section history-summary" aria-labelledby="decade-summary"><div class="section-head"><div><div class="eyebrow">2016–2025 Completed Seasons</div><h2 id="decade-summary">Verified decade summary</h2></div><p>Generated directly from the committed NOAA-derived dataset.</p></div><div class="history-stat-grid"><article><span>Total Hail Reports</span><strong>{summary.overall.report_count.toLocaleString()}</strong></article><article><span>Total Hail Days</span><strong>{summary.overall.hail_day_count}</strong></article><article><span>Largest Reported Hail</span><strong>{summary.overall.largest_reported_hail_inches.toFixed(2)} in.</strong></article><article><span>Reports ≥ 1 Inch</span><strong>{summary.overall.hail_report_count_1in_plus.toLocaleString()}</strong></article><article><span>Reports ≥ 2 Inches</span><strong>{summary.overall.hail_report_count_2in_plus.toLocaleString()}</strong></article><article><span>Closest Observation</span><strong>{summary.overall.closest_report_distance.toFixed(1)} mi.</strong></article><article><span>Most Active Month</span><strong>{summary.overall.most_active_month}</strong></article></div></section>

  <section class="section history-years" aria-labelledby="year-heading"><div class="section-head"><div><div class="eyebrow">Year Selector</div><h2 id="year-heading">Annual hail-report context</h2></div><p>Counts describe reports and hail days, not a number of separate storms.</p></div><div class="year-card-grid">{years.map(([year,value])=><details><summary><strong>{year}</strong><span>{value.report_count} reports · {value.hail_day_count} hail days</span></summary><dl><div><dt>Largest reported hail</dt><dd>{value.largest_reported_hail_inches?.toFixed(2)??'Not supplied'} in.</dd></div><div><dt>Reports ≥ 1 inch</dt><dd>{value.hail_report_count_1in_plus}</dd></div><div><dt>Reports ≥ 2 inches</dt><dd>{value.hail_report_count_2in_plus}</dd></div><div><dt>Most active month</dt><dd>{value.most_active_month}</dd></div><div><dt>Closest report</dt><dd>{value.closest_report_distance?.toFixed(1)} mi.</dd></div><div><dt>Locations represented</dt><dd>{Object.keys(value.reports_by_location_or_community).length}</dd></div></dl></details>)}</div></section>

  <section class="section history-map-section" aria-labelledby="map-heading"><div class="section-head"><div><div class="eyebrow">Coordinate Plot</div><h2 id="map-heading">Verified report locations</h2></div><p>The lightweight plot initializes only when scrolled into view. The complete accessible report table remains available below.</p></div><div class="history-map" data-history-map><canvas role="img" aria-label="Plot of verified NOAA hail-report coordinates within 50 miles of Greeley"></canvas><p class="map-status">Map ready to load when visible.</p><div class="map-detail" aria-live="polite"><strong>Select a plotted point for official report details.</strong></div></div><script is:inline id="history-map-data" type="application/json" set:html={JSON.stringify(mapData).replace(/</g,'\\u003c')} /></section>

  <section class="section history-records" id="history-records" aria-labelledby="records-heading"><div class="section-head"><div><div class="eyebrow">Accessible Historical Archive</div><h2 id="records-heading">All verified NOAA hail reports</h2></div><p><span data-result-count>{reports.length.toLocaleString()}</span> matching reports</p></div><form class="history-filters" data-history-filters><label>Year<select name="year"><option value="">All years</option>{years.map(([year])=><option value={year}>{year}</option>)}</select></label><label>Month<select name="month"><option value="">All months</option>{MONTHS.map(month=><option value={month}>{month}</option>)}</select></label><label>Hail size<select name="size"><option value="">All reported sizes</option><option value="1">At least 1 inch</option><option value="2">At least 2 inches</option><option value="missing">Magnitude not supplied</option></select></label><label>Distance<select name="distance"><option value="50">Within 50 miles</option><option value="25">Within 25 miles</option><option value="10">Within 10 miles</option><option value="5">Within 5 miles</option></select></label><label>Location/community<input name="location" type="search" list="history-locations" placeholder="Example: Greeley"/><datalist id="history-locations">{locations.map(location=><option value={location}/>)}</datalist></label><button type="reset">Reset filters</button></form><div class="table-wrap history-table"><table><caption>NOAA/NCEI Hail observations from 2016–2025 within 50 statute miles of the Greeley geographic anchor.</caption><thead><tr><th>Date and time</th><th>Location</th><th>County/zone</th><th>Reported size</th><th>Distance</th><th>Report source</th></tr></thead><tbody>{reports.map(r=><tr data-history-row data-year={r.year} data-month={r.month_name} data-size={r.magnitude??''} data-distance={r.distance_from_greeley_miles} data-location={`${r.begin_location??''} ${r.cz_name??''}`.toLowerCase()}><td>{r.begin_date_time??'Not supplied'}</td><td>{r.begin_location??'Not supplied'}</td><td>{r.cz_name??'Not supplied'}</td><td>{r.magnitude===null?'Not supplied':`${r.magnitude.toFixed(2)} in.`}</td><td>{r.distance_from_greeley_miles.toFixed(1)} mi.</td><td>{r.source??'Not supplied'}<br/><a href={r.noaa_event_url}>NOAA event {r.event_id}</a></td></tr>)}</tbody></table></div></section>

  <section class="section history-answers"><div><div class="eyebrow">Verified Answers</div><h2>What ten completed seasons show</h2></div><div><h3>How often has hail been reported near Greeley?</h3><p>NOAA/NCEI recorded <strong>{summary.overall.report_count.toLocaleString()} qualifying hail reports across {summary.overall.hail_day_count} hail days</strong> within 50 miles of the Greeley anchor during 2016–2025. Reports are observations, not a count of separate storms.</p><h3>Which months produced the most reports?</h3><p><strong>{summary.overall.most_active_month}</strong> produced the most qualifying reports, with {mostActiveMonthCount.toLocaleString()} observations in the verified dataset.</p><h3>What was the largest reported hail?</h3><p>The largest supplied NOAA magnitude was <strong>{summary.overall.largest_reported_hail_inches.toFixed(2)} inches</strong> within the defined radius during the completed period.</p><h3>Does a NOAA report prove vehicle damage?</h3><p>No. It confirms an official observation was recorded at a time and coordinate. It does not prove a particular vehicle was exposed or damaged; a direct inspection is required.</p></div></section>

  <section class="section history-method"><div><div class="eyebrow">Source &amp; Methodology</div><h2>NOAA/NCEI Storm Events Database</h2></div><div><dl><div><dt>Radius</dt><dd>50 statute miles from the Greeley geographic anchor</dd></div><div><dt>Completed period</dt><dd>2016–2025</dd></div><div><dt>Current season</dt><dd>2026 is provisional/current and excluded from completed-decade totals</dd></div><div><dt>Calculation</dt><dd>{manifest.geographic_filter.method}</dd></div><div><dt>Last generated</dt><dd>{new Date(manifest.generated_at).toLocaleString('en-US',{timeZone:'America/Denver',dateStyle:'medium',timeStyle:'short'})} MT</dd></div></dl><p>NOAA may correct or revise Storm Events archives. Peak Country filters and presents the underlying observations but did not create them.</p><a href="/data-sources/">Read the weather data methodology →</a></div></section>
  <nav class="section history-links" aria-label="Related hail and repair resources"><a href="/hail-tracker/">Live Hail Tracker →</a><a href="/hail-tracker/greeley/">Greeley Hail Tracker →</a><a href="/hail-tracker/weld-county/">Weld County Hail Tracker →</a><a href="/hail-tracker/northern-colorado/">Northern Colorado Tracker →</a><a href="/hail-size-guide/">Hail Size Guide →</a><a href="/after-a-hailstorm/">After a Hailstorm →</a><a href="/auto-hail-repair/">Auto Hail Repair →</a><a href="/paintless-dent-repair/">Paintless Dent Repair →</a><a href="/service-area/">Service Area →</a><a href="/repair-standards/">Repair Standards →</a><a href="/free-hail-inspection/">Free Hail Inspection →</a></nav>
</Layout>

<script>
  const form=document.querySelector<HTMLFormElement>('[data-history-filters]'),rows=[...document.querySelectorAll<HTMLTableRowElement>('[data-history-row]')],count=document.querySelector<HTMLElement>('[data-result-count]');
  function applyFilters(){if(!form)return;const data=new FormData(form),year=String(data.get('year')||''),month=String(data.get('month')||''),size=String(data.get('size')||''),distance=Number(data.get('distance')||50),location=String(data.get('location')||'').trim().toLowerCase();let visible=0;for(const row of rows){const magnitude=row.dataset.size===''?null:Number(row.dataset.size),show=(!year||row.dataset.year===year)&&(!month||row.dataset.month===month)&&(!location||row.dataset.location?.includes(location))&&Number(row.dataset.distance)<=distance&&(!size||(size==='missing'?magnitude===null:magnitude!==null&&magnitude>=Number(size)));row.hidden=!show;if(show)visible++;}if(count)count.textContent=visible.toLocaleString();document.dispatchEvent(new CustomEvent('history-filter',{detail:{year,month,size,distance,location}}));}
  form?.addEventListener('input',applyFilters);form?.addEventListener('reset',()=>setTimeout(applyFilters));
  const host=document.querySelector<HTMLElement>('[data-history-map]'),canvas=host?.querySelector('canvas'),status=host?.querySelector<HTMLElement>('.map-status'),detail=host?.querySelector<HTMLElement>('.map-detail'),raw=document.querySelector<HTMLScriptElement>('#history-map-data')?.textContent;let points:any[]=[],drawn:any[]=[];
  function draw(){if(!canvas||!host)return;const ratio=Math.min(devicePixelRatio||1,2),width=host.clientWidth,height=Math.max(330,Math.min(560,width*.55)),ctx=canvas.getContext('2d');canvas.width=width*ratio;canvas.height=height*ratio;canvas.style.height=`${height}px`;ctx?.setTransform(ratio,0,0,ratio,0,0);if(!ctx)return;ctx.fillStyle='#07192d';ctx.fillRect(0,0,width,height);ctx.strokeStyle='#3377a544';for(let i=1;i<5;i++){ctx.beginPath();ctx.arc(width/2,height/2,(Math.min(width,height)*.46/4)*i,0,Math.PI*2);ctx.stroke()}drawn=points.map(point=>{const x=20+(point.lon+106.1)/(2.45)*(width-40),y=20+(41.2-point.lat)/(2.45)*(height-40);ctx.fillStyle=point.size>=2?'#f2b84b':point.size>=1?'#5cbcff':'#d9e8f5';ctx.beginPath();ctx.arc(x,y,point.size>=2?3.3:2.1,0,Math.PI*2);ctx.fill();return{...point,x,y};});if(status)status.textContent=`${points.length.toLocaleString()} verified coordinates plotted. Select a point for details.`;}
  function loadMap(){if(!raw)return;points=JSON.parse(raw);draw();new ResizeObserver(draw).observe(host!);canvas?.addEventListener('click',event=>{const rect=canvas.getBoundingClientRect(),x=event.clientX-rect.left,y=event.clientY-rect.top,nearest=drawn.map(point=>({...point,d:Math.hypot(point.x-x,point.y-y)})).sort((a,b)=>a.d-b.d)[0];if(!nearest||nearest.d>14||!detail)return;detail.replaceChildren();const heading=document.createElement('strong');heading.textContent=`${nearest.date} · ${nearest.location||'Location not supplied'}`;const text=document.createElement('p');text.textContent=`${nearest.area||'Area not supplied'} · ${nearest.size===null?'Magnitude not supplied':nearest.size.toFixed(2)+' in.'} · ${nearest.distance.toFixed(1)} miles from Greeley · ${nearest.source||'Source not supplied'}`;const link=document.createElement('a');link.href=nearest.url;link.textContent=`Official NOAA event ${nearest.id} →`;detail.appendChild(heading);detail.appendChild(text);detail.appendChild(link);});}
  if(host)new IntersectionObserver(([entry],observer)=>{if(entry.isIntersecting){loadMap();observer.disconnect();}},{rootMargin:'150px'}).observe(host);
</script>
