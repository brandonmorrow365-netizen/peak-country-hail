---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { galleryImage, portfolioRepairs } from '../data/gallery';

const featuredRepairs = portfolioRepairs.slice(0, 3).map((repair) => ({
  repair,
  before: repair.photos.find((photo) => photo.state === 'before' && photo.angle === 1),
  after: repair.photos.find((photo) => photo.state === 'after' && photo.angle === 1),
}));

const services = [
  ['Hail damage', 'Dents across roofs, hoods, rails, doors, and quarter panels require careful lighting and a panel-by-panel inspection.', '/auto-hail-repair/'],
  ['Door dings', 'Small parking-lot dents may be good candidates for PDR when the paint is intact and the metal remains workable.', '/door-ding-repair/'],
  ['Creases', 'Repairability depends on the crease depth, length, panel location, finish condition, and access behind the metal.', '/door-ding-repair/'],
  ['Minor dents', 'Everyday dents deserve the same measured assessment as storm damage before a repair method is recommended.', '/paintless-dent-repair/'],
  ['Complex panel damage', 'Body lines, limited access, trim, and panel construction all affect how a skilled repair is planned.', '/repair-standards/']
];

---
<Layout
  title="Auto Hail Repair & PDR | Greeley, CO | Peak Country"
  description="Auto hail repair and paintless dent repair in Greeley and Northern Colorado, with direct guidance from an experienced PDR professional."
  exactTitle
>
  <section class="hero home-hero">
    <div class="home-hero__progressive-layer" data-future-vehicle-3d aria-hidden="true"></div>
    <div class="hero-copy">
      <div class="eyebrow">Greeley · Weld County · Northern Colorado</div>
      <h1>Auto Hail Repair &amp; Paintless Dent Repair in Greeley, Colorado</h1>
      <p class="hero-statement">An experienced PDR professional is involved from the first conversation through the repair.</p>
      <p class="hero-support">Peak Country provides auto hail repair and paintless dent repair for Greeley, Weld County, and Northern Colorado—helping you understand the damage and your options without the sales pressure.</p>
      <div class="actions">
        <a class="button" href="/free-hail-inspection/">Get Started →</a>
        <a href="/auto-hail-repair/">Explore Hail Repair →</a>
      </div>
    </div>
    <aside class="weather-card home-weather-card">
      <span class="status">Northern Colorado Hail Tracker</span>
      <h2>Know what has been reported.</h2>
      <p>Review current National Weather Service alerts and preliminary Storm Prediction Center hail reports for Weld and Larimer counties.</p>
      <p class="fine">Weather data can be delayed or incomplete. A nearby report does not confirm damage to your vehicle.</p>
      <a class="weather-card-link" href="/hail-tracker/">Open the Hail Tracker →</a>
    </aside>
  </section>

  <div class="band">
    <span>20+ years of professional PDR experience</span>
    <span>25+ years of collision-industry experience</span>
    <span>Mobile service throughout Northern Colorado</span>
  </div>

  <section class="section home-why">
    <div class="home-section-head">
      <div><div class="eyebrow">Why Peak Country</div><h2>Professional repair judgment before sales pressure.</h2></div>
      <p>Peak Country is built around experienced judgment, clear communication, skilled workmanship, and direct involvement throughout the repair process.</p>
    </div>
    <div class="trust-grid">
      <article><span>01</span><h3>Direct access to an experienced PDR professional</h3><p>An experienced PDR professional helps evaluate the damage, explain the options, and guide the repair process from the beginning.</p></article>
      <article><span>02</span><h3>More than 20 years of professional PDR experience</h3><p>More than 25 years across the collision industry brings a broader perspective to repair planning and vehicle construction.</p></article>
      <article><span>03</span><h3>The repair method should fit the vehicle</h3><p>Peak Country does not try to force every dent into PDR. If PDR is not the right choice, we will tell you.</p></article>
      <article><span>04</span><h3>Start with a conversation</h3><p>A Free Initial Assessment helps you understand the damage, whether PDR appears appropriate, repair options, and what type of evaluation may be needed next.</p></article>
    </div>
    <div class="home-trust-links" aria-label="Learn more about Peak Country"><a href="/about/">Meet the approach behind Peak Country →</a><a href="/service-area/">See the Greeley and Northern Colorado service area →</a></div>
  </section>

  <section class="section home-services">
    <div class="home-section-head">
      <div><div class="eyebrow">What We Repair</div><h2>From widespread hail dents to everyday damage.</h2></div>
      <p>An inspection determines what can be repaired with PDR and where another method may be more appropriate.</p>
    </div>
    <div class="service-card-grid">
      {services.map(([title, body, url], index) => <article class="service-card"><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p><a href={url}>Learn more →</a></article>)}
    </div>
  </section>

  <section class="section vehicle-care">
    <div class="vehicle-care-copy">
      <div class="eyebrow">The Entire Vehicle Matters</div>
      <h2>Careful access, protection, and reassembly are part of the repair.</h2>
      <p>A dent is only one part of the job. Proper PDR may require access behind a panel, removal of trim or interior components, protection of finished surfaces, and exact reassembly. Peak Country evaluates how the vehicle is built before deciding how to reach the damage.</p>
      <p>The goal is a considered repair plan that protects the whole vehicle.</p>
      <a href="/repair-standards/">Read Peak Country’s repair standards →</a>
    </div>
  </section>

  <section class="section home-gallery">
    <div class="home-section-head">
      <div><div class="eyebrow">Repair Portfolio</div><h2>Real Repairs. Real Results.</h2></div>
      <p>Quality is easier to trust when you can see the work. These are real before-and-after repair photographs, not stock images.</p>
    </div>
    <p class="home-gallery-disclosure"><em>Portfolio includes current Peak Country repairs and selected work personally completed by the owner throughout his professional PDR career.</em></p>
    <div class="home-gallery-grid">
      {featuredRepairs.map(({ repair, before, after }) => before && after && <article class="home-gallery-card">
        <h3>{repair.vehicle}</h3>
        <div class="home-gallery-pair">
          {[before, after].map((photo) => <figure>
            <picture>
              <source type="image/avif" srcset={`${galleryImage(repair, photo, 720, 'avif')} 720w, ${galleryImage(repair, photo, 1200, 'avif')} 1200w`} sizes="(max-width: 760px) calc(50vw - 32px), 360px" />
              <source type="image/webp" srcset={`${galleryImage(repair, photo, 720, 'webp')} 720w, ${galleryImage(repair, photo, 1200, 'webp')} 1200w`} sizes="(max-width: 760px) calc(50vw - 32px), 360px" />
              <img src={galleryImage(repair, photo, 1200, 'jpg')} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async" />
            </picture>
            <figcaption>{photo.state === 'before' ? 'Before' : 'After'}</figcaption>
          </figure>)}
        </div>
        <a href={`/gallery/#${repair.slug}`}>View this repair in the Gallery →</a>
      </article>)}
    </div>
    <p class="home-gallery-cta"><a class="button dark" href="/gallery/">See the Full Gallery →</a></p>
  </section>

  <section class="section hail-intelligence">
    <div class="home-section-head">
      <div><div class="eyebrow">Northern Colorado Hail Information</div><h2>Storm context from named official sources.</h2></div>
      <p>Useful weather information should make its source, freshness, and limitations clear.</p>
    </div>
    <div class="hail-intelligence-grid">
      <div>
        <p>Peak Country’s Hail Tracker uses National Weather Service alerts and preliminary NOAA Storm Prediction Center reports to add regional context after a storm.</p>
        <p>Reports are observations with varying coverage and location precision. They may be delayed, corrected, or incomplete. They do not prove that a specific vehicle was struck, and this website is not an emergency alerting service. Follow official warnings during severe weather, then inspect your vehicle safely after the storm.</p>
      </div>
      <nav class="hail-resource-links" aria-label="Hail information resources">
        <a href="/hail-tracker/"><span>Live regional view</span><strong>Hail Tracker →</strong></a>
        <a href="/hail-size-guide/"><span>Understand reported diameter</span><strong>Hail Size Guide →</strong></a>
        <a href="/after-a-hailstorm/"><span>Practical next steps</span><strong>After a Hailstorm →</strong></a>
        <a href="/northern-colorado-hail-history/"><span>Verified 2016–2025 archive</span><strong>Hail History →</strong></a>
        <a href="/data-sources/"><span>Methods and limitations</span><strong>Data Sources →</strong></a>
      </nav>
    </div>
  </section>

  <section class="section local-service">
    <div class="eyebrow">Local Mobile Service</div>
    <h2>Mobile convenience without lowering the repair standard.</h2>
    <p>Peak Country provides mobile PDR throughout Greeley and surrounding Northern Colorado communities. When an indoor or more controlled environment will provide a better evaluation or repair, we will recommend it.</p>
    <a href="/service-area/">View the mobile service area →</a>
  </section>

  <section class="section home-final-cta">
    <div><div class="eyebrow">Free Initial Assessment</div><h2>Start with a conversation—not a commitment.</h2><p>Submitting a request does not commit you to a repair. If professional estimating, documentation, or repair work carries a charge, it is explained before the work is performed.</p><p>Qualifying Peak Country PDR repairs are backed by a <a href="/repair-standards/">Limited Lifetime Workmanship Warranty</a>.</p></div>
    <div class="actions"><a class="button" href="/free-hail-inspection/">Get Started →</a><a href={`tel:${site.phone}`}>Call {site.phoneDisplay}</a></div>
  </section>

  <nav class="mobile-conversion" aria-label="Quick contact">
    <a href={`tel:${site.phone}`}>Call</a><a href={`sms:${site.phone}`}>Text</a><a href="/free-hail-inspection/">Get Started</a>
  </nav>
</Layout>
