---
import LocalHailPage from '../../../components/LocalHailPage.astro';
import reportsJson from '../../../../data/hail-history/hail-reports-2016-2025.json';
import type {HistoricalHailReport} from '../../../lib/hailHistory';
const records=(reportsJson as HistoricalHailReport[]).filter(report=>report.cz_name==='WELD');
const details:[string,string][]=[["Why Weld County needs a county-specific view", "Weld County covers a large area with varied terrain and storm paths. Hail observed near one community does not establish conditions elsewhere in the county. This page limits its historical figures to qualifying NOAA records whose source area field identifies Weld, preserving the distinction between official county attribution and simple geographic proximity."], ["Communities and source descriptions", "NOAA location text may name communities such as Greeley, Evans, Windsor, Eaton, Severance, Johnstown, Milliken, LaSalle, or Platteville, but it can also use airports and directional descriptions. The displayed wording remains tied to the official record. Peak Country does not convert a nearby coordinate into a city or county claim that the source does not support."], ["Live county weather context", "Official warning polygons can cross county lines or cover only part of Weld County. The main live tracker evaluates geometry and distance around Greeley when coordinates are available, while this page explains the county-specific historical view. Drivers should follow NWS warnings during severe weather and use the tracker only as informational context afterward."], ["From a county report to a vehicle inspection", "A Weld County hail report does not show whether a particular parking lot, home, or vehicle received hail. Exposure, shelter, wind, and storm variation all matter. Peak Country provides mobile PDR inspections by appointment across the working service area. An inspection under proper lighting establishes visible damage and whether Paintless Dent Repair is appropriate."]];
---
<LocalHailPage title="Weld County Hail Tracker | Peak Country" description="Review verified 2016–2025 NOAA/NCEI hail observations officially attributed to Weld County, current Northern Colorado source status and report limitations." h1="Weld County Hail Reports and Weather Context" eyebrow="NOAA-attributed Weld County observations" intro="Historical figures on this page include only records whose NOAA/NCEI CZ_NAME field identifies Weld. Proximity alone is not used to label a report as Weld County." scopeNote="The historical totals use qualifying 2016–2025 NOAA/NCEI Hail records within 50 miles of Greeley that are explicitly attributed to WELD in the source CZ_NAME field. Locations represented reflect NOAA source text and can include communities, airports, or directional location descriptions." interpretation="County attribution provides a useful Weld County view, but individual reports still have varying coordinate precision and coverage. A report documents an observation, not the extent of hail across the county or damage to a specific vehicle." liveContext="Current warnings can cross county boundaries, so the live tracker prioritizes official warning geometry around Greeley rather than relying only on county names." records={records} details={details} />
