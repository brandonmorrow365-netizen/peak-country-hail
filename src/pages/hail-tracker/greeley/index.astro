---
import LocalHailPage from '../../../components/LocalHailPage.astro';
import reportsJson from '../../../../data/hail-history/hail-reports-2016-2025.json';
import type {HistoricalHailReport} from '../../../lib/hailHistory';
const records=(reportsJson as HistoricalHailReport[]).filter(report=>report.distance_from_greeley_miles<=10);
const details:[string,string][]=[["How to read Greeley hail reports", "The closest reports are useful evidence that hail was observed near the city reference point, but they are not a neighborhood-by-neighborhood survey. A listed coordinate may be a spotter location, a directional description, or another source point. Compare the report time and distance with where the vehicle was parked, then inspect the vehicle itself before drawing a conclusion."], ["Why subtle damage can be missed", "Greeley drivers may see obvious dents on a hood yet miss shallow lows across the roof, rails, doors, or quarter panels. Outdoor light often hides slight changes in reflection. Controlled PDR lighting reveals panel shape more clearly and helps a technician evaluate paint condition, dent depth, metal stretch, and access."], ["Current reports and completed history serve different purposes", "The live tracker uses current NWS alerts and preliminary SPC reports for recent context. The historical figures here come from reviewed NOAA/NCEI records for 2016–2025. Current information can change quickly; historical records may also receive later NOAA corrections. Neither dataset should be treated as a vehicle damage diagnosis."], ["Arrange a Greeley-area inspection", "If your vehicle was outside during a reported storm, note where and when it was exposed and look at clean panels in directional light. Peak Country offers mobile Paintless Dent Repair by appointment in Greeley and surrounding communities. A hands-on inspection determines actual damage, PDR suitability, and realistic repair options."]];
---
<LocalHailPage title="Greeley Hail Tracker | Current & Historical Hail" description="Track official current hail context and verified 2016–2025 NOAA/NCEI observations nearest Greeley, with report distances, source details and damage limitations." h1="Greeley Hail Reports and Historical Context" eyebrow="Nearest to the Greeley geographic anchor" intro="A focused view of official weather information and verified historical hail observations within 10 miles of the Greeley city reference coordinate." scopeNote="This page’s historical figures use the verified 2016–2025 NOAA/NCEI dataset and include only qualifying observations calculated within 10 statute miles of the Greeley geographic anchor. The radius describes proximity to the city reference point; it is not a city-boundary claim." interpretation="Reports nearest Greeley provide local context about when and where hail was officially recorded. They do not establish that every neighborhood received hail, identify damage at an address, or prove that a particular vehicle was struck." liveContext="Recent Greeley-area activity is shown only when official NWS or SPC data is available and current." records={records} details={details} />
