---
import LocalHailPage from '../../../components/LocalHailPage.astro';
import reportsJson from '../../../../data/hail-history/hail-reports-2016-2025.json';
import {publicHistory,type HistoricalHailReport} from '../../../lib/hailHistory';
const records=publicHistory(reportsJson as HistoricalHailReport[]);
const details:[string,string][]=[["A regional view centered on Greeley", "Northern Colorado weather does not stop at municipal or county boundaries. The completed archive uses a consistent 50-statute-mile circle around the Greeley geographic anchor, allowing supported observations across parts of the Front Range to be compared without presenting the anchor as a business address or treating every record as a Greeley event."], ["Live information versus historical records", "Active NWS alerts and preliminary SPC reports answer what official sources are reporting now. The public NOAA/NCEI history window covers 2022 through 2026, with the current 2026 season kept preliminary in the live tracker until completed archive records are available. Keeping these sources separate prevents preliminary activity from silently changing verified historical totals and makes freshness easier to understand."], ["Interpreting regional patterns carefully", "Annual totals, months, magnitudes, and mapped coordinates can reveal where observations cluster, but reporting density is influenced by population, observer coverage, and source precision. Multiple reports may describe one storm episode. The regional count is therefore a count of qualifying observations rather than a measure of separate storms or damaged vehicles."], ["Using the tracker after a Northern Colorado storm", "Follow official warnings first. After the storm has passed, compare current reports with the vehicle’s location and exposure, photograph obvious damage, and look across clean panels in directional light. Peak Country serves Greeley, Weld County, and nearby Northern Colorado communities with mobile PDR by appointment. A professional inspection determines actual repairability."]];
---
<LocalHailPage title="Northern Colorado Hail Tracker | Peak Country" description="View official live Northern Colorado weather context and the verified 2022–2026 NOAA/NCEI hail-history window within 50 miles of the Greeley geographic anchor." h1="Northern Colorado Live and Historical Hail Reports" eyebrow="50-mile regional view centered on Greeley" intro="The broad regional view connects current NWS and preliminary SPC information with the current five-calendar-year public history window." scopeNote="The figures include qualifying completed NOAA/NCEI Hail observations in the 2022–2026 public window with a valid coordinate no more than 50 statute miles from the Greeley geographic anchor. The current 2026 season remains preliminary in the live tracker. The radius crosses county and municipal boundaries and is calculated from coordinates rather than approximated with place names." interpretation="This broader Northern Colorado context shows how report activity varies by year, month, location, distance, and recorded magnitude. Live preliminary data remains separate from reviewed historical records." liveContext="The regional live tracker prioritizes NWS warning polygons and SPC reports within approximately 50 miles while keeping broader Colorado alerts secondary." records={records} details={details} />
