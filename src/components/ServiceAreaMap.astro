---
import 'maplibre-gl/dist/maplibre-gl.css';
import { site } from '../data/site';
const { radiusMiles, referencePoint } = site.mobileServiceArea;
---
<section class="service-map-section" aria-labelledby="service-map-heading">
  <div class="section service-map-heading"><div><div class="eyebrow">Standard mobile-service area</div><h2 id="service-map-heading">A 25-mile geographic radius from downtown Greeley</h2></div><p>The blue circle shows the standard area where mobile travel is included where applicable. It is a straight-line geographic radius—not a driving-distance estimate and not a hard boundary for service.</p></div>
  <div class="section service-map-wrap"><div class="service-map" data-service-area-map data-latitude={referencePoint.latitude} data-longitude={referencePoint.longitude} data-radius-miles={radiusMiles} role="region" aria-label={`Interactive map of the standard ${radiusMiles}-mile mobile-service radius around downtown Greeley, Colorado`} aria-describedby="service-map-description"><p class="service-map-loading">Loading the interactive service-area map…</p></div><p id="service-map-description" class="service-map-description">Use the map controls to zoom and pan. The map uses a neutral downtown Greeley reference point only to calculate the radius; it does not identify a storefront, office, or residential address.</p><noscript><p class="service-map-noscript">The interactive map requires JavaScript. The standard mobile-service area is approximately 25 straight-line miles from a neutral downtown Greeley reference point; service may still be available outside the circle.</p></noscript></div>
</section>
<script>
  import maplibregl from 'maplibre-gl';
  const earthRadiusMiles = 3958.8;
  const radians = (value: number) => value * Math.PI / 180;
  const degrees = (value: number) => value * 180 / Math.PI;
  function circleCoordinates(latitude: number, longitude: number, radiusMiles: number) {
    const coordinates: [number, number][] = [];
    const angularDistance = radiusMiles / earthRadiusMiles;
    const originLatitude = radians(latitude);
    const originLongitude = radians(longitude);
    for (let bearing = 0; bearing <= 360; bearing += 4) {
      const bearingRadians = radians(bearing);
      const pointLatitude = Math.asin(Math.sin(originLatitude) * Math.cos(angularDistance) + Math.cos(originLatitude) * Math.sin(angularDistance) * Math.cos(bearingRadians));
      const pointLongitude = originLongitude + Math.atan2(Math.sin(bearingRadians) * Math.sin(angularDistance) * Math.cos(originLatitude), Math.cos(angularDistance) - Math.sin(originLatitude) * Math.sin(pointLatitude));
      coordinates.push([degrees(pointLongitude), degrees(pointLatitude)]);
    }
    return coordinates;
  }
  document.querySelectorAll<HTMLElement>('[data-service-area-map]').forEach((container) => {
    const latitude = Number(container.dataset.latitude), longitude = Number(container.dataset.longitude), radiusMiles = Number(container.dataset.radiusMiles);
    if (!Number.isFinite(latitude) || !Number.isFinite(longitude) || !Number.isFinite(radiusMiles)) return;
    const map = new maplibregl.Map({ container, center: [longitude, latitude], zoom: 8.65, minZoom: 6.5, maxZoom: 15, cooperativeGestures: true, style: { version: 8, sources: { carto: { type: 'raster', tiles: ['https://a.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png'], tileSize: 256, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>' } }, layers: [{ id: 'carto', type: 'raster', source: 'carto' }] } });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
    map.addControl(new maplibregl.ScaleControl({ unit: 'imperial' }), 'bottom-left');
    map.on('load', () => {
      const ring = circleCoordinates(latitude, longitude, radiusMiles);
      map.addSource('standard-mobile-service-area', { type: 'geojson', data: { type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [ring] } } });
      map.addLayer({ id: 'standard-mobile-service-area-fill', type: 'fill', source: 'standard-mobile-service-area', paint: { 'fill-color': '#1675b8', 'fill-opacity': 0.14 } });
      map.addLayer({ id: 'standard-mobile-service-area-outline', type: 'line', source: 'standard-mobile-service-area', paint: { 'line-color': '#075e9e', 'line-width': 3, 'line-opacity': 0.92 } });
      container.querySelector('.service-map-loading')?.remove();
    });
    map.on('error', () => { const loading = container.querySelector<HTMLElement>('.service-map-loading'); if (loading) loading.textContent = 'Map tiles could not be loaded. The standard mobile-service area remains approximately 25 straight-line miles from a neutral downtown Greeley reference point.'; });
  });
</script>
