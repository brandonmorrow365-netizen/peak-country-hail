---
import Layout from '../layouts/Layout.astro';
import {env} from 'cloudflare:workers';
import {readWeather,feedState} from '../lib/weather';
import {site} from '../data/site';
import {reportDate,subsetSummary,type HistoricalHailReport} from '../lib/hailHistory';
interface Props {title:string;description:string;h1:string;eyebrow:string;intro:string;scopeNote:string;records:HistoricalHailReport[];interpretation:string;liveContext:string;details:[string,string][]}
const {title,description,h1,eyebrow,intro,scopeNote,records,interpretation,liveContext,details}=Astro.props;
const summary=subsetSummary(records),live=await readWeather(env.DB),nwsState=feedState(live?.nws,live?.nwsSuccess,15),spcState=feedState(live?.spc,live?.spcSuccess,25);
const top=records.toSorted((a,b)=>a.distance_from_greeley_miles-b.distance_from_greeley_miles).slice(0,12);
const pageSchema={'@context':'https://schema.org','@type':'WebPage',name:h1,description,url:new URL(Astro.url.pathname,site.url).href,about:{'@type':'Dataset',name:'NOAA/NCEI Storm Events hail observations within 50 miles of Greeley, 2016–2025',creator:{'@type':'Organization',name:'NOAA National Centers for Environmental Information'}}};
---
<Layout title={title} description={description} exactTitle pageSchema={pageSchema}>
  <header class="page-head local-hail-head"><div class="eyebrow">{eyebrow}</div><h1>{h1}</h1><p>{intro}</p></header>
  <section class="section local-hail-live"><div><span>Live NWS status</span><strong>{nwsState==='current'?'Current':nwsState==='unavailable'?'Unavailable':'Cached / out of date'}</strong></div><div><span>Live SPC status</span><strong>{spcState==='current'?'Current':spcState==='unavailable'?'Unavailable':'Cached / out of date'}</strong></div><p>{liveContext} <a href="/hail-tracker/">Open the live Northern Colorado tracker</a> for timestamps, active warnings, preliminary reports, and source status.</p></section>
  <section class="section local-hail-stats"><div><span>Verified reports</span><strong>{summary.report_count.toLocaleString()}</strong></div><div><span>Hail days</span><strong>{summary.hail_day_count}</strong></div><div><span>Largest reported hail</span><strong>{summary.largest_reported_hail_inches?.toFixed(2)??'Not reported'} in.</strong></div><div><span>Closest report</span><strong>{summary.closest_report_distance?.toFixed(1)??'—'} mi.</strong></div></section>
  <section class="section local-hail-context"><div><div class="eyebrow">Verified Historical Context</div><h2>What the NOAA records show</h2><p>{scopeNote}</p><p>{interpretation}</p><p>These are individual qualifying official observations. Several reports can occur on one hail day or within one NOAA episode, so the report count must not be read as a count of separate storms.</p></div><aside><h3>Communities and source locations represented</h3><ul>{summary.locations.slice(0,15).map(([name,count])=><li><span>{name}</span><strong>{count}</strong></li>)}</ul></aside></section>
  <article class="section narrow prose local-hail-detail">{details.map(([heading,body])=><section><h2>{heading}</h2><p>{body}</p></section>)}</article>
  <section class="section local-hail-table"><div class="section-head"><div><div class="eyebrow">Nearest Verified Observations</div><h2>NOAA report details</h2></div><a href="/northern-colorado-hail-history/">Search the complete 2016–2025 archive →</a></div><div class="table-wrap"><table><caption>The 12 qualifying observations nearest the Greeley geographic anchor within this page’s stated scope.</caption><thead><tr><th>Date</th><th>Location</th><th>NOAA area</th><th>Size</th><th>Distance</th><th>Source</th></tr></thead><tbody>{top.map(r=><tr><td>{reportDate(r)}</td><td>{r.begin_location??'Not supplied'}</td><td>{r.cz_name??'Not supplied'}</td><td>{r.magnitude===null?'Not supplied':`${r.magnitude.toFixed(2)} in.`}</td><td>{r.distance_from_greeley_miles.toFixed(1)} mi.</td><td><a href={r.noaa_event_url}>NOAA event {r.event_id}</a></td></tr>)}</tbody></table></div></section>
  <nav class="section local-hail-links" aria-label="Related local hail information"><a href="/northern-colorado-hail-history/">Northern Colorado Hail History →</a><a href="/hail-size-guide/">Hail Size Guide →</a><a href="/after-a-hailstorm/">After a Hailstorm →</a><a href="/auto-hail-repair/">Auto Hail Repair →</a><a href="/free-hail-inspection/">Free Hail Inspection →</a></nav>
  <section class="section home-final-cta"><div><div class="eyebrow">Vehicle-specific answers</div><h2>Concerned about possible hail damage?</h2><p>Peak Country provides mobile PDR inspections by appointment in Greeley, Weld County, and nearby Northern Colorado communities.</p></div><div class="actions"><a class="button" href="/free-hail-inspection/">Request a Free Hail Inspection</a><a href={`tel:${site.phone}`}>Call {site.phoneDisplay}</a><a href={`sms:${site.phone}`}>Text Peak Country</a></div></section>
</Layout>
