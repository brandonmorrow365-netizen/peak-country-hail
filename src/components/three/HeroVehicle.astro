<div class="vehicle-experience" data-vehicle-experience>
  <div class="vehicle-stage" role="img" aria-label="Interactive luxury SUV in a Northern Colorado mountain storm">
    <img class="vehicle-poster" src="/brand/hero-storm-background.png" alt="Dark vehicle beneath a storm over mountain foothills" width="1942" height="809" fetchpriority="high" />
    <canvas aria-hidden="true"></canvas><div class="vehicle-loading" aria-live="polite">Preparing vehicle experience…</div>
  </div>
  <div class="storm-control"><label for="storm-intensity">Scene: <strong data-phase-label>Clear foothills</strong></label><input id="storm-intensity" type="range" min="0" max="4" step="1" value="0" aria-describedby="storm-help" /><p id="storm-help" class="fine">Clear weather → storm → hail → inspection → restored finish</p></div>
</div>
<script>
// @ts-nocheck -- isolated browser enhancement; runtime behavior is verified in the local preview.
const root=document.querySelector('[data-vehicle-experience]');
if(root){const canvas=root.querySelector('canvas'),poster=root.querySelector('.vehicle-poster'),loading=root.querySelector('.vehicle-loading'),slider=root.querySelector('input'),label=root.querySelector('[data-phase-label]'),phases=['Clear foothills','Storm approaching','Hail event','Vehicle inspection','Factory finish restored'],reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;let started=false;root.dataset.phase='0';
async function start(){if(started)return;started=true;try{const THREE=await import('three');const{GLTFLoader}=await import('three/examples/jsm/loaders/GLTFLoader.js');const renderer=new THREE.WebGLRenderer({canvas,antialias:innerWidth>700,alpha:true,powerPreference:'high-performance'});renderer.setPixelRatio(Math.min(devicePixelRatio,innerWidth<700?1.2:1.7));renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;const scene=new THREE.Scene();const camera=new THREE.PerspectiveCamera(34,1,.1,2000);camera.position.set(8,3.2,9);scene.add(new THREE.HemisphereLight(0xdcecff,0x17212b,2.5));const key=new THREE.DirectionalLight(0xffffff,4.5);key.position.set(-5,8,5);scene.add(key);const rim=new THREE.DirectionalLight(0x319cff,3.2);rim.position.set(6,3,-5);scene.add(rim);const shadow=new THREE.Mesh(new THREE.CircleGeometry(3.8,64),new THREE.MeshBasicMaterial({color:0x02070c,transparent:true,opacity:.48,depthWrite:false}));shadow.scale.set(1,.34,1);shadow.rotation.x=-Math.PI/2;shadow.position.set(0,-1.02,.15);scene.add(shadow);const hm=new THREE.MeshPhysicalMaterial({color:0xeaf6ff,roughness:.25});const hail=[];for(let i=0;i<(innerWidth<700?16:38);i++){const h=new THREE.Mesh(new THREE.SphereGeometry(.04+i%4*.012,8,8),hm);h.position.set((Math.random()-.5)*13,Math.random()*8,(Math.random()-.5)*8);h.userData.speed=2+Math.random()*3;hail.push(h);scene.add(h)}const gltf=await new GLTFLoader().loadAsync('/models/cadillac_escalade_spline_optimized.glb');const vehicle=gltf.scene,box=new THREE.Box3().setFromObject(vehicle),size=box.getSize(new THREE.Vector3()),center=box.getCenter(new THREE.Vector3());vehicle.position.sub(center);vehicle.scale.setScalar(5.8/Math.max(size.x,size.z));vehicle.rotation.y=-.62;scene.add(vehicle);const resize=()=>{const r=root.querySelector('.vehicle-stage').getBoundingClientRect();renderer.setSize(r.width,r.height,false);camera.aspect=r.width/r.height;camera.updateProjectionMatrix()};resize();new ResizeObserver(resize).observe(root);let px=0,py=0;root.addEventListener('pointermove',e=>{if(innerWidth<700||reduced)return;const r=root.getBoundingClientRect();px=(e.clientX-r.left)/r.width-.5;py=(e.clientY-r.top)/r.height-.5});slider.addEventListener('input',()=>{label.textContent=phases[+slider.value];root.dataset.phase=slider.value});poster.style.opacity='0';loading.remove();let last=performance.now();function loop(now){const dt=Math.min(.033,(now-last)/1000);last=now;const phase=+slider.value;hail.forEach(h=>{h.visible=phase===2;if(!reduced){h.position.y-=h.userData.speed*dt;if(h.position.y<-1)h.position.y=7}});vehicle.rotation.y+=((-.62+px*.14)-vehicle.rotation.y)*.04;camera.position.y+=((3.2-py*.25)-camera.position.y)*.04;camera.lookAt(0,.25,0);renderer.render(scene,camera);requestAnimationFrame(loop)}requestAnimationFrame(loop)}catch(e){loading.textContent='Interactive view unavailable. Static vehicle scene shown.';console.error(e)}}new IntersectionObserver((es,o)=>{if(es[0].isIntersecting){start();o.disconnect()}},{rootMargin:'250px'}).observe(root)}
</script>
