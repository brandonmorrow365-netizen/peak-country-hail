---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

interface Link { href: string; label: string }
interface Section { heading: string; paragraphs: string[]; links?: Link[] }
interface FAQ { question: string; answer: string }
interface EducationalFeature {
  eyebrow: string;
  heading: string;
  paragraphs: string[];
  image: { src: string; smallSrc: string; width: number; height: number; alt: string; caption: string; name: string; description: string };
  links: Link[];
  cta: Link;
}
interface Props { title: string; description: string; h1: string; intro: string; serviceType: string; sections: Section[]; faqs: FAQ[]; related: Link[]; educationalFeature?: EducationalFeature }
const { title, description, h1, intro, serviceType, sections, faqs, related, educationalFeature } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const serviceId = `${canonical}#service`;
const featureImageId = educationalFeature ? `${canonical}#reflection-light-image` : null;
const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', '@id': serviceId, name: serviceType, description, url: canonical, mainEntityOfPage: { '@id': `${canonical}#webpage` }, provider: { '@id': `${site.url}/#business` }, areaServed: [{ '@type':'City', name:'Greeley, Colorado' }, { '@type':'AdministrativeArea', name:'Weld County, Colorado' }, { '@type':'Place', name:'Northern Colorado' }], ...(featureImageId ? { image: { '@id': featureImageId } } : {}) },
    { '@type': 'FAQPage', '@id': `${canonical}#faq`, mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
    ...(educationalFeature && featureImageId ? [{ '@type':'ImageObject', '@id':featureImageId, contentUrl:new URL(educationalFeature.image.src,site.url).href, url:new URL(educationalFeature.image.src,site.url).href, name:educationalFeature.image.name, caption:educationalFeature.image.caption, description:educationalFeature.image.description, width:educationalFeature.image.width, height:educationalFeature.image.height, about:{ '@id':serviceId }, isPartOf:{ '@id':`${canonical}#webpage` } }] : [])
  ]
};
---
<Layout title={title} description={description} exactTitle pageSchema={pageSchema}>
  <header class="page-head service-head"><div class="eyebrow">Peak Country · Greeley · Northern Colorado</div><h1>{h1}</h1><p>{intro}</p><div class="service-head-actions"><a class="button" href="/free-hail-inspection/">Request a Free Hail Inspection →</a><a href="/process/">Review the repair process →</a></div></header>
  {educationalFeature && <section class="section service-education" aria-labelledby="service-education-heading">
    <figure class="service-education-media">
      <img src={educationalFeature.image.src} srcset={`${educationalFeature.image.smallSrc} 640w, ${educationalFeature.image.src} ${educationalFeature.image.width}w`} sizes="(max-width: 900px) calc(100vw - 48px), 470px" width={educationalFeature.image.width} height={educationalFeature.image.height} alt={educationalFeature.image.alt} loading="lazy" decoding="async" />
      <figcaption>{educationalFeature.image.caption}</figcaption>
    </figure>
    <div class="service-education-copy"><div class="eyebrow">{educationalFeature.eyebrow}</div><h2 id="service-education-heading">{educationalFeature.heading}</h2>{educationalFeature.paragraphs.map((paragraph,index)=><p class:list={{'direct-answer':index===0}}>{paragraph}</p>)}<p class="service-education-links">{educationalFeature.links.map((link,index)=><>{index>0&&' · '}<a href={link.href}>{link.label}</a></>)}</p><div class="service-education-cta"><p>Have a dent or hail damage you are unsure can be repaired with PDR?</p><a class="button" href={educationalFeature.cta.href}>{educationalFeature.cta.label} →</a></div></div>
  </section>}
  <article class="section service-detail">
    <div class="service-article">
      {sections.map((section) => <section><h2>{section.heading}</h2><p class="direct-answer">{section.paragraphs[0]}</p>{section.paragraphs.slice(1).map((paragraph) => <p>{paragraph}</p>)}{section.links && <div class="service-context-links">{section.links.map((link) => <a href={link.href}>{link.label} →</a>)}</div>}</section>)}
    </div>
    <aside class="service-sidebar"><div class="eyebrow">Peak Country Service</div><h2>A careful inspection comes first.</h2><p>Repairability depends on the vehicle, panel, paint, and damage—not a photograph or nearby weather report alone.</p><a class="button" href="/free-hail-inspection/">Request an Inspection →</a><a href="/about/">About Peak Country</a><a href="/repair-standards/">Repair standards</a><a href="/process/">What to expect</a></aside>
  </article>
  <section class="section service-faq"><div class="section-head"><div><div class="eyebrow">Service Questions</div><h2>Clear answers before repair.</h2></div><a href="/faq/">Visit the general FAQ →</a></div><div class="faq-list">{faqs.map(({ question, answer }, index) => <details open={index === 0}><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
  <section class="section service-related"><div><div class="eyebrow">Continue Your Research</div><h2>Repair and hail information in one place.</h2></div><nav aria-label="Related service resources">{related.map((link) => <a href={link.href}>{link.label} →</a>)}</nav></section>
  <section class="about-cta service-cta"><div><div class="eyebrow">Greeley · Weld County · Northern Colorado</div><h2>Start with a free hail or dent inspection.</h2><p>Call or text <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a> to discuss your vehicle and mobile service location.</p><div class="about-actions"><a class="button" href="/free-hail-inspection/">Request a Free Hail Inspection →</a><a class="text-link" href={`sms:${site.phone}`}>Text Peak Country →</a></div></div></section>
</Layout>
