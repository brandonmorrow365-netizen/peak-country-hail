---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

interface Link { href: string; label: string }
interface Section { heading: string; paragraphs: string[]; links?: Link[] }
interface FAQ { question: string; answer: string }
interface Props { title: string; description: string; h1: string; intro: string; serviceType: string; sections: Section[]; faqs: FAQ[]; related: Link[] }
const { title, description, h1, intro, serviceType, sections, faqs, related } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', '@id': `${canonical}#service`, name: serviceType, description, url: canonical, provider: { '@id': `${site.url}/#business` }, areaServed: ['Greeley, Colorado', 'Weld County, Colorado', 'Northern Colorado'] },
    { '@type': 'FAQPage', '@id': `${canonical}#faq`, mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) }
  ]
};
---
<Layout title={title} description={description} pageSchema={pageSchema}>
  <header class="page-head service-head"><div class="eyebrow">Peak Country · Greeley · Northern Colorado</div><h1>{h1}</h1><p>{intro}</p><div class="service-head-actions"><a class="button" href="/free-hail-inspection/">Request a Free Hail Inspection →</a><a href="/process/">Review the repair process →</a></div></header>
  <article class="section service-detail">
    <div class="service-article">
      {sections.map((section) => <section><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{section.links && <div class="service-context-links">{section.links.map((link) => <a href={link.href}>{link.label} →</a>)}</div>}</section>)}
    </div>
    <aside class="service-sidebar"><div class="eyebrow">Peak Country Service</div><h2>A careful inspection comes first.</h2><p>Repairability depends on the vehicle, panel, paint, and damage—not a photograph or nearby weather report alone.</p><a class="button" href="/free-hail-inspection/">Request an Inspection →</a><a href="/about/">About Peak Country</a><a href="/repair-standards/">Repair standards</a><a href="/process/">What to expect</a></aside>
  </article>
  <section class="section service-faq"><div class="section-head"><div><div class="eyebrow">Service Questions</div><h2>Clear answers before repair.</h2></div><a href="/faq/">Visit the general FAQ →</a></div><div class="faq-list">{faqs.map(({ question, answer }, index) => <details open={index === 0}><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
  <section class="section service-related"><div><div class="eyebrow">Continue Your Research</div><h2>Repair and hail information in one place.</h2></div><nav aria-label="Related service resources">{related.map((link) => <a href={link.href}>{link.label} →</a>)}</nav></section>
  <section class="about-cta service-cta"><div><div class="eyebrow">Greeley · Weld County · Northern Colorado</div><h2>Start with a free hail or dent inspection.</h2><p>Call or text <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a> to discuss your vehicle and mobile service location.</p><div class="about-actions"><a class="button" href="/free-hail-inspection/">Request a Free Hail Inspection →</a><a class="text-link" href={`sms:${site.phone}`}>Text Peak Country →</a></div></div></section>
</Layout>
