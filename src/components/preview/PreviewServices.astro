---

<section id="what-we-repair" class="pc-services pc-contour-surface" aria-labelledby="pc-services-heading">
  <div class="pc-content-width pc-services__overview">
    <header class="pc-services__lead">
      <p class="pc-kicker">What we repair</p>
      <h2 id="pc-services-heading">
        <span>Real solutions</span>
        <span>for real vehicles.</span>
      </h2>
      <p>Experienced evaluation for hail damage, dents, and mobile PDR—starting with the repair method that fits the vehicle.</p>
      <a class="pc-text-link" href="#services-in-detail">Explore Our Services <span aria-hidden="true">↓</span></a>
    </header>

    <ol class="pc-services__categories">
      {overview.map((service) => (
        <li>
          <a href={service.href}>
            <picture>
              {'avif' in service && <source type="image/avif" srcset={service.avif} />}
              {'webp' in service && <source type="image/webp" srcset={service.webp} />}
              <img src={service.image} width="720" height="540" alt={service.alt} loading="lazy" decoding="async" />
            </picture>
            <span class="pc-services__number" aria-hidden="true">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.body}</p>
          </a>
        </li>
      ))}
    </ol>
  </div>

  <div id="services-in-detail" class="pc-services__detail" aria-labelledby="pc-services-detail-heading">
    <header class="pc-content-width pc-services__detail-heading">
      <div>
        <p class="pc-kicker">Our services in detail</p>
        <h2 id="pc-services-detail-heading">More than just dent removal.</h2>
      </div>
      <p>Repairability, access, finish condition, working environment, documentation, and the customer’s goal all matter.</p>
    </header>

    <div class="pc-content-width pc-services__detail-grid">
      {details.map((service) => (
        <article id={service.id} class="pc-services__detail-item" aria-labelledby={`${service.id}-heading`}>
          <figure>
            <picture>
              <source type="image/avif" srcset={service.avif} />
              <source type="image/webp" srcset={service.webp} />
              <img src={service.image} width="720" height="540" alt={service.alt} loading="lazy" decoding="async" />
            </picture>
            <figcaption>{service.eyebrow}</figcaption>
          </figure>
          <p class="pc-services__detail-index">{service.number}</p>
          <h3 id={`${service.id}-heading`}>{service.title}</h3>
          <p class="pc-services__detail-copy">{service.body}</p>
          <ul>
            {service.benefits.map((benefit) => <li>{benefit}</li>)}
          </ul>
          <a href={service.href}>{service.link} <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>

    <aside class="pc-content-width pc-services__fit" aria-labelledby="pc-repair-fit-heading">
      <p class="pc-label">The right repair for your vehicle</p>
      <h2 id="pc-repair-fit-heading">PDR is not automatically the correct method for every dent.</h2>
      <p>Peak Country evaluates the damage, construction, paint, access, requirements, and your goals before explaining the options.</p>
      <div>
        <a href="/repair-standards/">How repairability is evaluated <span aria-hidden="true">→</span></a>
        <a href="/get-started/">Start the conversation <span aria-hidden="true">→</span></a>
      </div>
    </aside>
  </div>
</section>
