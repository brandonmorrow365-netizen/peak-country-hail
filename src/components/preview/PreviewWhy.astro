const principles = [
  {
    number: '01',
    title: 'Direct access to experience',
    body: 'An experienced PDR professional helps evaluate the damage, explain the options, and guide the repair from the beginning.',
  },
  {
    number: '02',
    title: '20+ years of PDR experience',
    body: 'Experience with both PDR and the broader collision industry informs how the repair is approached.',
  },
  {
    number: '03',
    title: 'The repair method should fit the vehicle',
    body: 'Not every dent should be forced into PDR. If another method makes more sense, we’ll explain why.',
  },
  {
    number: '04',
    title: 'Start with a conversation',
    body: 'Understand the damage and your options before making a repair decision. No obligation, just straight answers.',
  },
] as const;
---

<section id="why-peak-country" class="pc-why" aria-labelledby="pc-why-heading">
  <div class="pc-why__credibility" aria-label="Peak Country experience and service">
    <div class="pc-shell-width pc-why__credibility-inner">
      <div><strong>20+ years</strong><span>Professional PDR experience</span></div>
      <div><strong>25+ years</strong><span>Collision-industry experience</span></div>
      <div><strong>Mobile service</strong><span>Throughout Northern Colorado</span></div>
    </div>
  </div>

  <div class="pc-why__spread">
    <figure class="pc-why__photo">
      <picture>
        <source media="(max-width: 680px)" srcset="/images/pdr-light-reflection-paintless-dent-repair-greeley-co-640.jpg" />
        <img
          src="/images/pdr-light-reflection-paintless-dent-repair-greeley-co.jpg"
          width="977"
          height="1139"
          alt="PDR reflection light revealing distortion in a vehicle panel during paintless dent repair"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <figcaption><span>Real vehicles.</span><span>Real repairs.</span><span>Northern Colorado.</span></figcaption>
    </figure>

    <div class="pc-why__panel">
      <header class="pc-why__copy">
        <p class="pc-kicker">Why Peak Country</p>
        <h2 id="pc-why-heading">
          <span>Repair experience you</span>
          <span>can trust. No sales pressure.</span>
        </h2>
        <p>Peak Country is built on hands-on experience, honest guidance, and quality workmanship. You’ll work directly with an experienced PDR professional who helps evaluate the damage, explain your options, and guide the repair from start to finish.</p>
      </header>

      <ol class="pc-why__principles">
        {principles.map((principle) => (
          <li>
            <span class="pc-why__number" aria-hidden="true">{principle.number}</span>
            <div>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </div>
          </li>
        ))}
      </ol>

    </div>
  </div>
  <div class="pc-why__mountains" aria-hidden="true"></div>
</section>
