---
const steps = [
  {
    number: '01',
    title: 'Start the conversation',
    body: 'Share the basics through Get Started; photos are helpful but optional. The request creates no obligation or commitment.',
    image: '/media/portfolio/toyota-4runner/before-angle-1.jpg',
    avif: '/media/portfolio/toyota-4runner/before-angle-1-720.avif',
    webp: '/media/portfolio/toyota-4runner/before-angle-1-720.webp',
    alt: 'Toyota 4Runner panel before paintless dent repair',
  },
  {
    number: '02',
    title: 'Review the damage',
    body: 'An experienced technician personally reviews the vehicle under proper lighting and evaluates the paint, metal, and access.',
    image: '/images/pdr-light-reflection-paintless-dent-repair-greeley-co.jpg',
    alt: 'PDR reflection light used to evaluate panel damage',
  },
  {
    number: '03',
    title: 'Understand the options',
    body: 'Peak Country explains where PDR fits, when another method may be better, and any paid estimating scope and price first.',
    image: '/media/portfolio/lexus-rx/before-angle-1.jpg',
    avif: '/media/portfolio/lexus-rx/before-angle-1-720.avif',
    webp: '/media/portfolio/lexus-rx/before-angle-1-720.webp',
    alt: 'Lexus RX dent before repair evaluation',
  },
  {
    number: '04',
    title: 'Approve the repair',
    body: 'There is no checkout or automatic payment. No paid estimate, documentation, or repair begins without your approval.',
    image: '/media/portfolio/nissan-murano/before-angle-2.jpg',
    avif: '/media/portfolio/nissan-murano/before-angle-2-720.avif',
    webp: '/media/portfolio/nissan-murano/before-angle-2-720.webp',
    alt: 'Nissan Murano panel before an approved paintless dent repair',
  },
  {
    number: '05',
    title: 'Repair + documentation',
    body: 'Authorized work follows the agreed scope, with careful access, reassembly, quality review, and proportionate records.',
    image: '/media/portfolio/2013-silverado/after-angle-3.jpg',
    avif: '/media/portfolio/2013-silverado/after-angle-3-720.avif',
    webp: '/media/portfolio/2013-silverado/after-angle-3-720.webp',
    alt: 'Chevrolet Silverado panel after paintless dent repair',
  },
] as const;

const safeguards = ['No obligation', 'No commitment', 'No checkout', 'Approval before paid work'] as const;
---

<section id="process" class="pc-process pc-contour-surface" aria-labelledby="pc-process-heading">
  <div class="pc-content-width pc-process__intro">
    <div>
      <p class="pc-kicker">The process</p>
      <h2 id="pc-process-heading">
        <span>A straightforward process</span>
        <span>from start to finish.</span>
      </h2>
    </div>
    <div class="pc-process__promise">
      <p>No pressure. Just clear communication, honest guidance, and quality repairs.</p>
      <a href="/get-started/">Begin with Get Started <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="pc-content-width">
    <ol class="pc-process__steps">
      {steps.map((step) => (
        <li>
          <span class="pc-process__number" aria-hidden="true">{step.number}</span>
          <h3>{step.title}</h3>
          <picture>
            {'avif' in step && <source type="image/avif" srcset={step.avif} />}
            {'webp' in step && <source type="image/webp" srcset={step.webp} />}
            <img src={step.image} width="720" height="540" alt={step.alt} loading="lazy" decoding="async" />
          </picture>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>

    <div class="pc-process__base">
      <div class="pc-process__safeguards" aria-label="Get Started safeguards">
        {safeguards.map((safeguard) => <span>{safeguard}</span>)}
      </div>
      <div class="pc-process__actions">
        <a class="pc-button" href="/get-started/">Get Started</a>
        <a class="pc-text-link" href="/process/">View the full repair process <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
