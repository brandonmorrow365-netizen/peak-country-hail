{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peak-country-hail",
  "workers_dev": false,
  "preview_urls": false,
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "peakcountryhail.com", "custom_domain": true, "zone_id": "d6e49058279e791997df3572ac0a1a8f" }],
  "assets": { "binding": "ASSETS", "directory": "./dist/client" },
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  "observability": { "enabled": true },
  "vars": { "SITE_STAGE": "production", "FORMS_ENABLED": "true", "WEATHER_ENABLED": "true", "TURNSTILE_SITE_KEY": "0x4AAAAAAEqmpyWStR8CCtOH" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "peak-country-hail-db",
    "database_id": "8ad357b0-1dae-468d-bb3a-fe39b939428a",
    "migrations_dir": "migrations"
  }]
}
